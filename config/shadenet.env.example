# Shadenet (A place in the shade) — environment template (TASK-02)
#
# Shell-escaped template for docker-compose.yml env_file. This file contains
# ONLY the redacted placeholders — no real secrets. Copy to .env and fill in
# real values there (docker-compose.yml loads .env via env_file).
#
# Rules:
#   - Never commit real secrets (access policy blocks reading .env).
#   - SHADENET_LAT / SHADENET_LON / SHADENET_RADIUS_KM drive the autonomous
#     geographic bootstrap; omit to fall back to the existing shadenet.db.
#   - SHADENET_DEV_MODE=1 issues mock 21+ attestations for CI and testing.
#   - CADDY_MASTER_PASSWORD must be set if Caddy key management is enabled.

# Geographic bootstrap (comma-separated lat/lon, radius in km).
# SHADENET_LAT=37.7749
# SHADENET_LON=-122.4194
# SHADENET_RADIUS_KM=25

# Local database path (defaults to /data/shadenet.db in the container).
# SHADENET_DB=/data/shadenet.db

# Internal web server port.
# NIGHTCAL_PORT=8765

# If you bind the web server to all interfaces, set the host to 0.0.0.0.
# NIGHTCAL_HOST=0.0.0.0

# ZKP 21+ dev bypass flag (set 1 for automated testing / CI).
# SHADENET_DEV_MODE=0

# Tri-node mesh host ids.
# SHADENET_PRIMARY=hetzner
# SHADENET_DARKNET=tor-onion
# SHADENET_EDGE=raspberrypi

# Caddy key management (set a strong password if enabling ACME / key auth).
# CADDY_MASTER_PASSWORD=

# Optional per-node database override (used by sync_mesh.py).
# SHADENET_DB_HETZNER=/data/shadenet.db
# SHADENET_DB_TOR_ONION=/data/shadenet.db
# SHADENET_DB_RASPBERRY_PI=/data/shadenet.db

# Tor data directory.
# TOR_DATA_DIRECTORY=/var/lib/tor/shadenet
