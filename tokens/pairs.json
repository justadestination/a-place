{
  "$description": "Every foreground/background pairing the components actually use, with its WCAG 2.2 minimum. tokens/build.py fails the build if a theme misses one; the runtime theme API (web/js/core/theme.js) uses the same list to reject agent overrides that would break AA. Add a row whenever a component pairs two color tokens.",
  "pairs": [
    { "fg": "text", "bg": "bg", "min": 4.5, "use": "Body text on the page" },
    { "fg": "text", "bg": "surface", "min": 4.5, "use": "Body text on cards" },
    { "fg": "text", "bg": "surface-raised", "min": 4.5, "use": "Dialog and popover text" },
    { "fg": "text", "bg": "surface-sunken", "min": 4.5, "use": "Text in wells and month cells" },
    { "fg": "text-muted", "bg": "bg", "min": 4.5, "use": "Secondary text on the page" },
    { "fg": "text-muted", "bg": "surface", "min": 4.5, "use": "Secondary text on cards" },
    { "fg": "text-muted", "bg": "surface-raised", "min": 4.5, "use": "Secondary text in dialogs" },
    { "fg": "text-muted", "bg": "surface-sunken", "min": 4.5, "use": "Secondary text in wells" },
    { "fg": "accent-text", "bg": "bg", "min": 4.5, "use": "Accent-coloured text on the page" },
    { "fg": "accent-text", "bg": "surface", "min": 4.5, "use": "Accent-coloured text on cards" },
    { "fg": "link", "bg": "bg", "min": 4.5, "use": "Links on the page" },
    { "fg": "link", "bg": "surface", "min": 4.5, "use": "Links on cards" },
    { "fg": "link", "bg": "surface-raised", "min": 4.5, "use": "Links in dialogs" },
    { "fg": "on-accent", "bg": "accent", "min": 4.5, "use": "Primary button label" },
    { "fg": "selected-text", "bg": "selected-bg", "min": 4.5, "use": "Selected day / selected segment" },
    { "fg": "border-strong", "bg": "bg", "min": 3, "use": "Control borders on the page (1.4.11)" },
    { "fg": "border-strong", "bg": "surface", "min": 3, "use": "Control borders on cards (1.4.11)" },
    { "fg": "focus", "bg": "bg", "min": 3, "use": "Focus ring on the page (2.4.13)" },
    { "fg": "focus", "bg": "surface", "min": 3, "use": "Focus ring on cards" },
    { "fg": "focus", "bg": "surface-raised", "min": 3, "use": "Focus ring in dialogs" },
    { "fg": "today", "bg": "surface", "min": 3, "use": "Today marker (non-text)" },
    { "fg": "today", "bg": "surface-sunken", "min": 3, "use": "Today marker in month cells" },
    { "fg": "accent", "bg": "bg", "min": 1.0, "use": "Accent fill is decorative; meaning is carried by on-accent text. Listed so overrides stay a valid color." },

    { "fg": "kind-music-fg", "bg": "kind-music-bg", "min": 4.5, "use": "Kind tag label" },
