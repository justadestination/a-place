    { "fg": "kind-food-mark", "bg": "surface", "min": 3, "use": "Kind glyph on cards" },
    { "fg": "kind-other-mark", "bg": "surface", "min": 3, "use": "Kind glyph on cards" },
    { "fg": "kind-music-mark", "bg": "surface-sunken", "min": 3, "use": "Kind glyph in month cells" },
