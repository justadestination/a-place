    { "fg": "kind-show-fg", "bg": "kind-show-bg", "min": 4.5, "use": "Kind tag label" },
    { "fg": "kind-trivia-fg", "bg": "kind-trivia-bg", "min": 4.5, "use": "Kind tag label" },
