  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    }
  },
  "density": {
    "compact": 0.8,
    "comfortable": 1,
    "spacious": 1.25
  },
  "z": {
    "base": "0",
    "raised": "10",
    "overlay": "100",
    "toast": "200"
  }
