      "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
    },
    "size": {
      "xs": "0.8125rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "2xl": "2rem",
      "3xl": "2.75rem",
      "display": "clamp(2.25rem, 1.5rem + 3.5vw, 4rem)"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "bold": "700",
      "heavy": "800"
    },
    "line-height": {
      "tight": "1.1",
      "snug": "1.3",
      "normal": "1.5"
    },
    "tracking": {
      "tight": "-0.02em",
      "normal": "0",
      "caps": "0.06em"
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem"
