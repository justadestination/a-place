# Copy to .env and export it before a hand start:
#   set -a; . ./.env; set +a
# The night calendar does not read this file by itself.
# The systemd unit in config/nightcal.service sets the same night-calendar
# variables in Environment= lines. Do not put real tokens in that unit.

# Addresses the night calendar binds. Comma-separated.
# Loopback only on a laptop. On the fleet host, add the nebula address
# so the reverse proxy can reach the sheet.
NIGHTCAL_HOST=127.0.0.1
NIGHTCAL_PORT=8765

# SQLite store. Unset uses data/shadenet.db next to the repo.
# The database is local evidence and is not committed.
# NIGHTCAL_DB=/absolute/path/to/shadenet.db

# --- Derivee agent (agent/scaffold) ---

# Matrix access token for the rendezvous room. Leave unset and the
# matrix_signal tool reports not-configured instead of failing.
# MATRIX_ACCESS_TOKEN=

# Cloud model key, used only when agent/scaffold/config/agent.yaml
# escalates off the local model. Never commit a real value.
# CLOUD_API_KEY=

# Agent log. Default level is INFO. AGENT_LOG_FORMAT=json sends JSON
# to stderr. AGENT_LOG_FILE empty disables the rotating file.
# AGENT_LOG_LEVEL=INFO
# AGENT_LOG_FORMAT=
# AGENT_LOG_FILE=state/logs/agent.log

# Leave at 0. Setting this to 1 swaps stdout and breaks the MCP stdio stream.
# AGENT_STDOUT_GUARD=0
